# ---------- General ----------
VERSION=1.0.0
TZ=America/Argentina/Mendoza

# ---------- Borde público (obligatorias) ----------
# Host por el que Traefik atiende al orquestador (sin esquema ni puerto)
PUBLIC_HOST=pdf-extractext.universidad.localhost
# URL pública completa con la que se generan los links (tls=true => https)
PUBLIC_BASE_URL=https://pdf-extractext.universidad.localhost

# ---------- Redis stream (orquestador -> persistidor) ----------
# redis://[:password@]host:port[/db]
REDIS_URL=redis://redis:6379/0
STREAM_NAME=document-events
# Tope aproximado del stream (XADD MAXLEN ~). Acordar el valor con el Persistidor.
STREAM_MAX_LEN=10000

# ---------- Consul (servicios/consul) ----------
# Vacía para no registrarse en Consul (por ejemplo, en desarrollo sin Consul).
CONSUL_HTTP_ADDR=http://consul:8500
# Solo si el ACL de Consul exige token para registrar servicios.
CONSUL_HTTP_TOKEN=
