# Copiar a .env y completar. Estos valores los consumen los docker-compose de despliegue, no el
# servicio Go (que lee las variables directamente de su entorno).

# Tag de la imagen que se construye y se levanta.
VERSION=0.1.0

# Zona horaria, propagada a los contenedores y montada como /etc/localtime.
TZ=America/Argentina/Mendoza

# --- Borde público (traefik-public) ---
# Host por el que el cliente alcanza la API. El router enruta Host(...) && PathPrefix(/api/v1).
PUBLIC_HOST=api.example.com
# URL pública base; el servicio la usa para componer el header Location absoluto.
PUBLIC_BASE_URL=https://api.example.com
# Activa TLS en el router público ("true"/"false"). En local se deja en false.
PUBLIC_TLS=false
# Límites del borde: promedio y ráfaga por cliente (ADR-0007).
RATE_LIMIT_AVERAGE=100
RATE_LIMIT_BURST=200

# --- Orquestador ---
STREAM_NAME=document-events
MAX_DOCUMENT_BYTES=10485760
EXTRACTOR_TIMEOUT=30s
SUMMARIZER_TIMEOUT=120s
EXTRACT_MAX_IN_FLIGHT=16
SUMMARY_MAX_IN_FLIGHT=4
LOG_LEVEL=info
